# =====================================================================
# INTRADAY TRADING PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your credentials.
# NEVER COMMIT .env TO VERSION CONTROL.
# =====================================================================

# ---------------------------------------------------------------------
# 1. ANGEL ONE SMARTAPI CREDENTIALS
# ---------------------------------------------------------------------
ANGELONE_API_KEY=your_angel_one_api_key_here
ANGELONE_CLIENT_ID=your_angel_one_client_code_here
ANGELONE_PASSWORD=your_angel_one_mpin_or_password_here
ANGELONE_TOTP_SECRET=your_base32_totp_secret_key_here

# ---------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH CREDENTIALS
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATIONS
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numerical_telegram_chat_id_here

# ---------------------------------------------------------------------
# 4. APPLICATION RUNTIME & SECURITY GATES
# ---------------------------------------------------------------------
APP_ENV=development
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
TIMEZONE=Asia/Kolkata
API_PORT=8000
REGISTERED_STATIC_IP=

# ---------------------------------------------------------------------
# 5. STRATEGY & RISK MANAGEMENT PARAMETERS
# ---------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.0
MAX_TRADES_PER_DAY=2
MAX_OPEN_POSITIONS=1
DEFAULT_REWARD_RISK=2.0
VIRTUAL_STARTING_CAPITAL=10000
MAX_SLIPPAGE_PCT=0.05
