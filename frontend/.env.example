# Intraday-Bot Frontend Environment Variables (Public)
# Only publishable/anon keys are permitted here. NEVER put service_role or API secrets here.

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Publishable Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Active Bot User ID for the Clean ₹10,000 Paper Trading Account
VITE_TARGET_USER_ID=00000000-0000-0000-0000-000000000002

# Active Bot Trading Account ID
VITE_TARGET_ACCOUNT_ID=f8a6bf13-31e4-4429-98f5-5e2d4bc72d1b

# Application Mode (paper only)
VITE_APP_MODE=paper
